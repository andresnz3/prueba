NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=pos_multitenant
DB_USER=pos_backend
# Completar con la credencial local; nunca subir .env.
DB_PASSWORD=
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=3000
HEALTH_TIMEOUT_MS=4000
SHUTDOWN_TIMEOUT_MS=10000
JSON_LIMIT_BYTES=16384

# Generar localmente: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=
COOKIE_SAME_SITE=lax
SESSION_TTL_SECONDS=1800
SESSION_MAX_SECONDS=28800
AUTHORIZATION_TTL_SECONDS=300
AUTH_RATE_WINDOW_SECONDS=900
AUTH_RATE_MAX=10

# Fotografias privadas: ruta ABSOLUTA fuera del repositorio; obligatoria en produccion.
# Desarrollo sin esta variable: <directorio de usuario>/.pos/product-images
# Contabo: IMAGE_STORAGE_DIR=/var/lib/pos/product-images (volumen persistente y respaldo)
