NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=pos_multitenant
DB_USER=pos_backend
# Completar con la credencial local; nunca subir .env.
DB_PASSWORD=
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=3000
HEALTH_TIMEOUT_MS=4000
SHUTDOWN_TIMEOUT_MS=10000
JSON_LIMIT_BYTES=16384

# Generar localmente: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=
COOKIE_SAME_SITE=lax
SESSION_TTL_SECONDS=1800
SESSION_MAX_SECONDS=28800
AUTHORIZATION_TTL_SECONDS=300
AUTH_RATE_WINDOW_SECONDS=900
AUTH_RATE_MAX=10
AUTH_LOGIN_IP_MAX=50
# Reautorización de módulos: cuotas independientes del inicio de sesión.
AUTH_REAUTH_WINDOW_SECONDS=900
AUTH_REAUTH_SESSION_MAX=10
AUTH_REAUTH_USER_MAX=50
AUTH_REAUTH_IP_MAX=100

# Fotografias privadas: ruta ABSOLUTA fuera del repositorio; obligatoria en produccion.
# Desarrollo sin esta variable: <directorio de usuario>/.pos/product-images
# Contabo: IMAGE_STORAGE_DIR=/var/lib/pos/product-images (volumen persistente y respaldo)

# Servicio opcional de licencias permanentes del modo local.
# Configurar solo en el backend central de licencias; nunca incluir secretos en el frontend.
# Pepper estable para HMAC, mínimo 32 bytes aleatorios codificados en hexadecimal.
LOCAL_LICENSE_CODE_PEPPER=
# Identificador público versionado que debe existir en local-license-config.js al publicar.
LOCAL_LICENSE_SIGNING_KEY_ID=
# Clave privada PEM P-256, únicamente en un almacén de secretos del servidor.
LOCAL_LICENSE_SIGNING_PRIVATE_KEY=
