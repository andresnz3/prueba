ARG FRONTEND_BASE
ARG BACKEND_BASE
ARG FRONTEND_BASE_ID
ARG BACKEND_BASE_ID
ARG PACKAGE_SHA256

FROM ${FRONTEND_BASE} AS active_frontend
FROM ${BACKEND_BASE} AS patcher
ARG FRONTEND_BASE_ID
ARG BACKEND_BASE_ID
ARG PACKAGE_SHA256
COPY --chown=node:node apply-invoice-overlay.cjs /tmp/apply-invoice-overlay.cjs
COPY --chown=node:node frontend.patch /tmp/frontend.patch
COPY --chown=node:node --from=active_frontend /usr/share/nginx/html /tmp/site
RUN node /tmp/apply-invoice-overlay.cjs frontend /tmp/site /tmp/frontend.patch ${PACKAGE_SHA256}

FROM ${FRONTEND_BASE}
ARG FRONTEND_BASE_ID
ARG BACKEND_BASE_ID
ARG PACKAGE_SHA256
LABEL org.softventa.invoice.frontend-base-image-id="${FRONTEND_BASE_ID}" \
      org.softventa.invoice.backend-base-image-id="${BACKEND_BASE_ID}" \
      org.softventa.invoice.package-sha256="${PACKAGE_SHA256}"
COPY --from=patcher /tmp/site /usr/share/nginx/html