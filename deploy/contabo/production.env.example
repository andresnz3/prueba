# Plantilla sin credenciales. Guardar la copia real fuera del repositorio,
# con permisos 600. Usar valores aleatorios independientes para las claves.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
CSRF_SECRET=

# Nombre dedicado a esta instalación; no reutilizar pos_docker_local.
POS_DATABASE_NAME=pos_production
POS_HTTP_PORT=8080
CORS_ORIGINS=https://pos.ejemplo.com

# Licencias permanentes; completar solo con secretos de producción protegidos.
# La clave privada PEM se representa en una sola línea con saltos como \n.
LOCAL_LICENSE_CODE_PEPPER=
LOCAL_LICENSE_SIGNING_KEY_ID=
LOCAL_LICENSE_SIGNING_PRIVATE_KEY=
