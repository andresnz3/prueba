# Docker Compose only. Copy to .env and replace every blank credential with a random value.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
CSRF_SECRET=

# Optional local perpetual-license service. Keep these secrets only on the backend.
# The matching public JWK is versioned in local-license-config.js for each release.
LOCAL_LICENSE_CODE_PEPPER=
LOCAL_LICENSE_SIGNING_KEY_ID=
# Set as one line with PEM newlines escaped as \n; never commit the value.
LOCAL_LICENSE_SIGNING_PRIVATE_KEY=

# Exact origins users enter in the browser, without paths or a trailing slash.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
POS_HTTP_PORT=8080

# One trusted hop locally (Nginx). Set to 2 behind a separate host reverse proxy on Contabo.
TRUST_PROXY_HOPS=1
