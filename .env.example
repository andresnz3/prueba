# Docker Compose only. Copy to .env and replace every blank credential with a random value.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
CSRF_SECRET=

# Exact origins users enter in the browser, without paths or a trailing slash.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
POS_HTTP_PORT=8080

# One trusted hop locally (Nginx). Set to 2 behind a separate host reverse proxy on Contabo.
TRUST_PROXY_HOPS=1
